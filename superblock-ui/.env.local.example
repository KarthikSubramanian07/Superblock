# Mapbox — get from mapbox.com → Tokens
VITE_MAPBOX_TOKEN=

# Backend server
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/map/tiles

# API endpoint paths — real backend
VITE_API_PATH_HEALTH=/health
VITE_API_PATH_TILES=/map/tiles
VITE_API_PATH_HOTSPOTS=/agents/hotspots
VITE_API_PATH_SIMULATE=/simulate/intervention
VITE_API_PATH_PLANNER_INTERVENTIONS=/planner/interventions
VITE_API_PATH_DIAGNOSIS=/agents/diagnosis/red-zone-alerts
VITE_API_PATH_INGESTION_STATUS=/demo/status

# Connection tuning (optional — defaults shown)
VITE_POLL_INTERVAL_MS=30000
VITE_WS_RECONNECT_MS=5000
VITE_HEALTH_TIMEOUT_MS=2000
