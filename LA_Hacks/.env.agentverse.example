# Copy to LA_Hacks/.env before running agents
# cp .env.agentverse.example .env

# ASI:One
ASI_ONE_API_KEY=replace_with_real_asi_one_key
ASI_ONE_ENDPOINT=https://api.asi1.ai/v1/chat/completions
ASI_ONE_MODEL=asi1-mini

# Local endpoint host for manifests
AGENT_ENDPOINT_HOST=127.0.0.1

# Deterministic seeds (change for production)
INGESTION_AGENT_SEED=superblock-ingestion-seed-la-hacks-2026
MAPPING_AGENT_SEED=superblock-mapping-seed-la-hacks-2026
DIAGNOSIS_AGENT_SEED=superblock-diagnosis-seed-la-hacks-2026
SIMULATION_AGENT_SEED=superblock-simulation-seed-la-hacks-2026
PLANNER_AGENT_SEED=superblock-planner-seed-la-hacks-2026
NARRATOR_AGENT_SEED=superblock-narrator-seed-la-hacks-2026
COORDINATOR_AGENT_SEED=superblock-coordinator-seed-la-hacks-2026

# Ports (must be unique)
INGESTION_AGENT_PORT=8101
MAPPING_AGENT_PORT=8102
DIAGNOSIS_AGENT_PORT=8103
SIMULATION_AGENT_PORT=8104
PLANNER_AGENT_PORT=8105
NARRATOR_AGENT_PORT=8106
COORDINATOR_AGENT_PORT=8107

# Coordinator -> backend bridge
BACKEND_ORCHESTRATE_URL=http://127.0.0.1:8000/agents/orchestrate

# Optional cross-agent wiring for distributed message forwarding
# Leave blank for registration/discovery only.
MAPPING_AGENT_ADDRESS=
DIAGNOSIS_AGENT_ADDRESS=
SIMULATION_AGENT_ADDRESS=
