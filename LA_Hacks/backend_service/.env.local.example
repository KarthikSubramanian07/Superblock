# ASI:One (Fetch.ai) — get from https://asi1.ai → Account → API Keys
# Rotate any key that ever appeared in git history (see SECURITY.md).
ASI_ONE_API_KEY=

# MongoDB Atlas — rotate password if the old URI was ever committed (see SECURITY.md).
MONGO_URI=

# Auth0 — required when DEMO_MODE=false
# Domain example: your-tenant.us.auth0.com
AUTH0_DOMAIN=
# API Identifier / Audience from Auth0 API settings
AUTH0_AUDIENCE=

# Security
# false (default): production posture — Auth0 on writes, World ID fail-closed
# true: local hackathon / CI only
DEMO_MODE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MAX_EDGE_PACKETS=50000

# Agent seeds (required when DEMO_MODE=false). Generate new random phrases after rotation.
INGESTION_AGENT_SEED=
MAPPING_AGENT_SEED=
DIAGNOSIS_AGENT_SEED=
SIMULATION_AGENT_SEED=
PLANNER_AGENT_SEED=
NARRATOR_AGENT_SEED=
