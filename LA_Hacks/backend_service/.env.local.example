# ASI:One (Fetch.ai) — get from https://asi1.ai → Account → API Keys
ASI_ONE_API_KEY=

# MongoDB Atlas — get from cloud.mongodb.com → Database Access
MONGO_URI=

# Auth0 — get from manage.auth0.com → Applications → your app
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Security
# true (default): local hackathon demo — write routes open, World ID mock proofs allowed
# false: require Auth0 on write routes + real World ID proofs on ingest
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MAX_EDGE_PACKETS=50000
